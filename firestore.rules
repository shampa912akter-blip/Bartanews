rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // In a real app, we'd check a roles collection or custom claims.
      // For this demo, we'll allow the user's specific email if they sign in.
      return isSignedIn() && (
        request.auth.token.email == 'sae61125912@gmail.com' ||
        request.auth.token.email == 'shampa912akter@gmail.com'
      ) && request.auth.token.email_verified == true;
    }

    function isValidNews(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             (data.audio == null || (data.audio is string && data.audio.size() <= 500)) &&
             data.time == request.time;
    }

    match /news/{newsId} {
      // Everyone can read news articles
      allow read: if true;

      // Only the specific admin email can write
      allow create, update, delete: if isSignedIn() && 
                                      request.auth.token.email == 'shampa912akter@gmail.com' &&
                                      request.auth.token.email_verified == true;
    }
  }
}
